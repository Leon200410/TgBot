# 把本文件复制一份改名为 .env,然后填写下面的值

# 在 https://my.telegram.org 登录 -> API development tools -> 创建应用后获得
API_ID=123456
API_HASH=your_telegram_api_hash

# 保持在线时段(按 TZ 时区的本地时间):
# 旧写法:
#   ONLINE_HOURS=always
#   ONLINE_HOURS=9:00-23:00
# 新写法(优先级更高,适合按周几分别配置):
#   WEEKDAY_ONLINE_HOURS=10-13,15-19,20-22
#   SATURDAY_ONLINE_HOURS=10-13,15-19
#   SUNDAY_ONLINE_HOURS=
ONLINE_HOURS=
WEEKDAY_ONLINE_HOURS=10-13,15-19,20-22
SATURDAY_ONLINE_HOURS=10-13,15-19
SUNDAY_ONLINE_HOURS=

# 时区,影响 ONLINE_HOURS 的时间计算
TZ=Asia/Shanghai

# 宿主机语音服务地址。容器和语音服务在同一台电脑时不用改;
# 如果容器部署在别的机器(如 NAS),改成 Windows 电脑的局域网 IP,如 http://192.168.1.100:8929/speak
# TTS_URL=http://host.docker.internal:8929/speak

# Telegram 活跃会话里显示的设备信息
DEVICE_MODEL=Your Device
SYSTEM_VERSION=Your OS Version
APP_VERSION=1.0

# 保持在线心跳参数:
#   ONLINE_PING_SECONDS            纯状态上报间隔
#   ONLINE_ACTIVITY_PING_SECONDS   对收藏夹做一次无痕保活 ping 的间隔
ONLINE_PING_SECONDS=20
ONLINE_ACTIVITY_PING_SECONDS=240

# 查岗机器人关键词自动回复。默认关闭，确认用户名后改为 true。
# 只处理指定机器人的新私聊消息，不补回复启动前的历史消息。
AUTO_CHECKIN_ENABLED=false
CHECKIN_BOT_USERNAME=your_checkin_bot_username
# 使用另一个普通私人号测试时才开启，仍只回复上面指定的账号。
CHECKIN_ALLOW_USER_TEST=false
